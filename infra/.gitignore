# Local .terraform directory (downloaded providers and modules)
**/.terraform/*

# Terraform state files (even with GCS remote backend, avoid accidental local state commits)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude any .tfvars files that may contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files if you use them locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc